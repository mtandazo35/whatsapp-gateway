# Caddy obtiene SSL automatico de Let's Encrypt para {$DOMAIN}.
# Requisitos: $DOMAIN apuntando a la IP del servidor + puertos 80/443 abiertos.

{$DOMAIN} {
    encode zstd gzip

    # Tamano max de upload (25 MB)
    request_body {
        max_size 25MB
    }

    # Cabeceras de seguridad para el frontend y la API.
    # CSP: scripts solo propios y de jsdelivr (Bootstrap); estilos inline los
    # necesita Bootstrap; imagenes data: para el QR y el favicon.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # API NestJS por reverse proxy
    handle /api/* {
        reverse_proxy api:3005 {
            transport http {
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    # Frontend estatico
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}
