# Copiar a .env y rellenar (install.sh lo genera con valores aleatorios si no existe)

# ==== DOMINIO ====
# Caddy obtiene SSL automatico de Let's Encrypt para este dominio.
# REQUERIDO: el dominio debe apuntar a la IP de este servidor con un registro A.
DOMAIN=ejemplo.midominio.com

# ==== POSTGRES (interno al docker-compose) ====
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=whatsapp
# true = TypeORM crea/altera tablas automaticamente al arrancar.
# Dejar en true SOLO en el primer boot (no hay migrations todavia).
# Cambiar a false despues de que las tablas existen para evitar perder columnas.
DB_SYNC=true

# ==== SEGURIDAD ====
# JWT secret (32 chars aleatorios). Generar con: openssl rand -hex 32
JWT_SECRET=cambiame-32chars-aleatorios

# ==== WEBHOOK SALIENTE (opcional) ====
# Si se define, cada mensaje entrante y cada cambio de estado de sesion
# (open/close) y de mensaje (delivered/read) se envia por POST a esta URL.
# WEBHOOK_SECRET firma el body con HMAC-SHA256 en el header X-Signature.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ==== BACKUP ====
# Dias de retencion para scripts/backup.sh
BACKUP_RETENTION_DAYS=30
